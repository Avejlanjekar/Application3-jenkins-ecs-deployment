{
  "containerDefinitions": [
    {
      "name": "react-java-mysql-backend",
      "image": "288497659312.dkr.ecr.ap-south-1.amazonaws.com/react-java-mysql-backend-${ENV}:${COMMIT_ID}",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "react-java-mysql-backend-8080-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "MYSQL_HOST",
          "value": "app3-db-service"
        },
        {
          "name": "MYSQL_ROOT_PASSWORD",
          "value": "db-57xsl"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/react-java-mysql-backend",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "react-java-mysql-backend",
  "executionRoleArn": "arn:aws:iam::288497659312:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "3072"
}