{
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "288497659312.dkr.ecr.ap-south-1.amazonaws.com/react-java-mysql-frontend-${ENV}:${COMMIT_ID}",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "name": "main-80-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "BACKEND_HOST",
          "value": "app3-backend-${ENV}.app3.local"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/react-java-Mysql-Frontend",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "react-java-mysql-frontend",
  "executionRoleArn": "arn:aws:iam::288497659312:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}